{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AIDLC-GUI",
  "version": "0.1.0",
  "identifier": "dev.vugarsafarzada.aidlc-gui",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AIDLC-GUI",
        "width": 1280,
        "height": 820,
        "minWidth": 920,
        "minHeight": 640,
        "center": true,
        "decorations": true,
        "transparent": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "A visual interface for AI-DLC",
    "longDescription": "An unofficial community desktop interface for AWS Labs AI-DLC.",
    "copyright": "Copyright 2026 AIDLC-GUI contributors",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "wix": null,
      "nsis": null
    }
  }
}
